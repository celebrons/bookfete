# HTTPS automatique devant l'API et le site.
#
# Render fournissait le certificat sans qu'on ait rien a faire. Sur une
# machine nue, il faut le demander soi-meme — Caddy le fait, l'installe et le
# renouvelle tout seul.
#
# LE NOM DE DOMAINE : Let's Encrypt ne delivre pas de certificat pour une
# simple adresse IP. Tant que le domaine Celebrons n'est pas achete, on passe
# par sslip.io : <ip>.sslip.io resout vers <ip>, sans rien configurer, et
# permet donc d'obtenir un vrai certificat des maintenant.
#
# Le jour ou le domaine existe, remplacer la premiere ligne par :
#   celebrons.fr, www.celebrons.fr
# et recharger : systemctl reload caddy

78.232.5.181.sslip.io {
	# Le site ET l'API sont servis par le meme processus node (SERVE_FRONTEND=1),
	# donc une seule redirection suffit : Caddy ne fait que le HTTPS et passe
	# tout le reste tel quel.
	reverse_proxy 127.0.0.1:5000 {
		# Un rendu PDF depasse deux minutes : sans cela, Caddy couperait la
		# requete avant la fin et l'utilisateur verrait une erreur alors que
		# le serveur travaille encore.
		transport http {
			read_timeout 600s
			write_timeout 600s
		}
	}

	encode gzip

	log {
		output file /var/log/caddy/celebrons.log
		format console
	}
}
