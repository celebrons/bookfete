# Variables d'environnement du backend Bookipix.
#
# CE FICHIER NE CONTIENT AUCUN SECRET : ce sont les NOMS attendus, avec des
# valeurs a remplacer. Le vrai fichier s'appelle backend/.env, il est ignore
# par git (voir .gitignore) et se copie a la main sur le serveur :
#
#   scp backend/.env root@<ip>:/home/celebrons/bookfete/backend/.env
#
# Ne jamais le commiter, ne jamais le coller dans une conversation.

# --- Indispensable ---------------------------------------------------------

# Base de donnees et stockage. Pendant la phase de test Scaleway, on garde
# EXACTEMENT le meme Supabase que Render : rien n'est migre.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

PORT=5000
NODE_ENV=production

# Adresse publique du site, utilisee dans les liens des emails.
# Production : https://bookipix.com une fois le DNS confirme, sinon
# https://78.232.5.181.sslip.io en attendant (voir deploy/README.md).
FRONTEND_URL=https://bookipix.com
PUBLIC_APP_URL=https://bookipix.com

# --- Impression ------------------------------------------------------------

GELATO_API_KEY=...

# NE PAS METTRE A 1 SUR LE SERVEUR DE TEST.
# A 1, chaque envoi cree une commande REELLE, facturee et imprimee. Laisser
# vide : les envois restent des brouillons.
# GELATO_LIVE_ORDERS=

# --- Paiement --------------------------------------------------------------

STRIPE_ENABLED=1
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CHECKOUT_SUCCESS_URL=https://bookipix.com/checkout/succes
STRIPE_CHECKOUT_CANCEL_URL=https://bookipix.com/checkout/annule

# --- Emails ----------------------------------------------------------------

# Brevo (300 emails/jour gratuits). L'expediteur doit etre verifie cote
# tableau de bord Brevo avant le premier envoi reel.
BREVO_API_KEY=xkeysib-...
EMAIL_FROM=Bookipix <bonjour@bookipix.com>

# --- Facultatif ------------------------------------------------------------

# Navigateur de rendu. A laisser vide : le code trouve tout seul le Chromium
# installe par Puppeteer dans backend/.cache/puppeteer.
# PDF_BROWSER_PATH=

# Reglages memoire de sharp. Les valeurs par defaut (cache desactive,
# concurrence 1) sont deja celles qui conviennent a une petite machine.
# SHARP_CONCURRENCY=1
# SHARP_CACHE=

# Espace d administration.
#
# ADMIN_EMAILS : les adresses qui y ont acces de plein droit. Vide ou
# absent = espace ferme (jamais ouvert par defaut).
# ADMIN_EMAILS=vous@exemple.fr
#
# ADMIN_ACCESS_CODE : un code partage qui ouvre l espace a N IMPORTE QUEL
# compte CONNECTE qui le presente. Pratique pour tester avec plusieurs
# comptes sans inscrire chaque adresse ci-dessus.
#
# Douze caracteres au minimum, sinon il est ignore et la porte reste
# fermee : un code court se devine. Cet espace montre les livres, les
# contenus et les adresses de TOUS les comptes — a reserver a la phase de
# test, et a retirer en production.
# ADMIN_ACCESS_CODE=
