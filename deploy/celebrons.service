# Service systeme de l'API Celebrons.
#
# systemd plutot que pm2 : rien de plus a installer, redemarrage automatique
# apres un plantage ET apres un reboot de la machine, journaux consultables
# avec `journalctl -u celebrons -f`.
#
# Installe par deploy/install-serveur.sh dans /etc/systemd/system/.

[Unit]
Description=API Celebrons (bookfete)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=celebrons
WorkingDirectory=/home/celebrons/bookfete/backend
EnvironmentFile=/home/celebrons/bookfete/backend/.env
ExecStart=/usr/bin/node server.js

# Un rendu PDF dure plusieurs minutes et monte a ~600 Mo (node + Chromium).
# Sur une machine de 2 Go, un redemarrage trop prompt pendant un rendu
# gaspillerait le travail deja fait : on laisse le temps de finir proprement.
Restart=always
RestartSec=5
TimeoutStopSec=300
KillSignal=SIGTERM

# KillMode=mixed : le SIGTERM ne va qu au processus principal (node).
#
# Par defaut, systemd l'envoie a TOUT le groupe — donc aussi au navigateur
# de rendu, qui meurt sur-le-champ. L arret propre cote node (voir
# server.js) etait alors sans effet : il attendait la fin de travaux dont
# le navigateur venait d etre tue, et le rendu echouait avec « le
# navigateur a ferme la connexion (code 1006) ».
#
# En mode mixed, node recoit le signal, laisse finir ce qui tourne, puis
# sort. Le reste du groupe ne recoit SIGKILL qu au bout de
# TimeoutStopSec, en dernier recours.
KillMode=mixed

# Le navigateur headless est lance par l'application : il doit pouvoir ecrire
# ses fichiers temporaires.
PrivateTmp=false

# --- PLAFOND DE RESSOURCES (2026-09-19) ---
#
# La machine est devenue injoignable pendant un rendu : elle repondait
# encore au ping, mais ni le site ni SSH ne repondaient. Rien ne bornait
# l'application, donc Chrome pouvait prendre les 2 Go et le reste du
# systeme n'avait plus de quoi tourner.
#
# Render faisait mieux SANS avoir plus de memoire : il tuait le processus
# a 512 Mo. Une erreur franche vaut mieux qu'une machine dans le coma.
# C'est ce comportement qu'on reproduit ici, avec un plafond plus haut.
#
# Chrome est un enfant de node : il est dans le meme groupe de controle,
# donc les limites ci-dessous couvrent bien le rendu complet.

# 1,5 Go pour l'application. Le reste (500 Mo) est ce qui garde sshd,
# Caddy et le systeme joignables — c'est la marge qui permet de reprendre
# la main sans passer par la console Scaleway.
MemoryHigh=1200M
MemoryMax=1500M

# Pas d'echange sur le disque : c'est lui qui transforme un depassement
# de memoire (quelques secondes) en machine inutilisable (plusieurs
# minutes). Mieux vaut etre tue net.
MemorySwapMax=0

# Si le noyau doit tuer quelque chose, qu'il prenne le navigateur et pas
# tout le service : node survit et signale un rendu echoue.
OOMPolicy=continue

# Le rendu ne doit jamais prendre TOUT le processeur : il faut qu'il reste
# de quoi repondre a une requete et accepter une connexion SSH. 160 % sur
# 2 vCPU laisse 0,4 vCPU au reste.
# 180 % : le rendu peut prendre presque toute la machine, PARCE QU'IL
# tourne en priorite basse (voir pdfService.js, nice). Il rend la main des
# que l'API a quelque chose a repondre.
#
# Le bridage a 120 % essaye plus tot reglait la reactivite mais rendait la
# fabrication interminable : plus de vingt minutes pour un livre de 33
# pages. La priorite est le bon levier, pas le plafond.
CPUQuota=180%
CPUWeight=50
IOWeight=50

StandardOutput=journal
StandardError=journal
SyslogIdentifier=celebrons

[Install]
WantedBy=multi-user.target
