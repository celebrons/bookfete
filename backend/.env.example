# Supabase
SUPABASE_URL=votre_url_supabase
SUPABASE_SERVICE_ROLE_KEY=votre_clé_service_role

# Application
FRONTEND_URL=http://localhost:3000
PORT=5000
NODE_ENV=development
DEBUG_AUTH=0
AUTH_CACHE_TTL_MS=60000
AUTH_CACHE_MAX_ENTRIES=2000
STRIPE_ENABLED=0
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Local uniquement (sans signature webhook) : 1 = accepte un payload JSON non signe
STRIPE_WEBHOOK_ALLOW_UNSIGNED=0

# Email (Brevo — dashboard.brevo.com > Parametres SMTP & API > Cles API)
BREVO_API_KEY=xkeysib-xxx
# Expediteur VERIFIE dans Brevo (Expediteurs, domaines et IP dediee >
# Expediteurs) : sans verification, Brevo refuse l'envoi.
EMAIL_FROM=Celebrons <bonjour@exemple.fr>
# Ancien fournisseur, laisse en place au cas ou (services/email/resendClient.js)
RESEND_API_KEY=re_xxx

# Impression (Gelato) — cle depuis dashboard.gelato.com > Store settings > API keys
GELATO_API_KEY=votre_cle_api_gelato
# 0 (defaut) = chaque commande Impression/Pack payee cree un BROUILLON Gelato
# (rien facture/imprime/expedie, a valider manuellement dans leur dashboard).
# 1 = commande REELLE soumise automatiquement (facturation + production +
# expedition immediates) a chaque paiement confirme — ne jamais passer a 1
# sans une decision explicite et recente en ce sens.
GELATO_LIVE_ORDERS=0

# Verrouillage du livre apres paiement (backend/middleware/bookEditLock.js).
# 0/absent (defaut, recommande en production) = un livre dont une commande a
# ete payee ne peut plus etre modifie (pages, format, couverture...).
# 1 = MODE TEST : la modification reste possible malgre le paiement, pour
# pouvoir rejouer un parcours complet sans recreer un livre a chaque fois —
# ne jamais laisser a 1 une fois de vrais clients payants.
ALLOW_BOOK_EDITS_AFTER_PAYMENT=0

# Sécurité
SESSION_SECRET=une_chaine_aleatoire_tres_longue

# Espace d administration (backend/middleware/requireAdmin.js).
# Liste d emails separes par des virgules. VIDE OU ABSENTE = espace FERME
# a tout le monde : une variable oubliee doit fermer la porte, pas l ouvrir.
# Un administrateur voit les livres et les emails de TOUS les utilisateurs.
ADMIN_EMAILS=vous@exemple.fr
